      "Bash(* /proc/*/environ*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(export -p*)",
      "Bash(export)",
      "Bash(declare -x*)",
      "Bash(declare -p*)",
      "Bash(declare)",
      "Bash(set)"
    ]
  }
